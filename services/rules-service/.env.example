# rules-service en local (copia a .env).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# Contraseña de tu PostgreSQL local (vacía si no tiene). Es la misma en core y rules;
# el plurione-demo del docker-compose.yml solo aplica a la base del contenedor.
DB_PASSWORD=
DB_NAME=plurione_compliance

# La misma clave en core, rules y ai (32 caracteres o más).
JWT_SECRET=

# Precarga idempotente del catálogo de reglas al arrancar.
AUTO_SEED=true
