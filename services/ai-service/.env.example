# ai-service en local (copia a .env). Detalle de cada variable: services/ai-service/README.md.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.0

# Tesseract con los idiomas spa y eng.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANG=spa
OCR_DPI=300

CORE_BASE_URL=http://127.0.0.1:8001
RULES_BASE_URL=http://127.0.0.1:8002

# La misma clave en core, rules y ai (32 caracteres o más).
JWT_SECRET=
