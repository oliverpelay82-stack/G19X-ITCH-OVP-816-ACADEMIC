# core-service en local (copia a .env). Lista completa de variables: CLAUDE.md §7.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# Contraseña de tu PostgreSQL local (vacía si no tiene). Es la misma en core y rules;
# el plurione-demo del docker-compose.yml solo aplica a la base del contenedor.
DB_PASSWORD=
DB_NAME=plurione_compliance

# Llave AES-256 de la bóveda (RNF-04), 64 caracteres hexadecimales; vacía, los documentos se guardan
# en claro. Guárdela también fuera del equipo: sin ella, los documentos cifrados no se recuperan.
# Generar: python -c "import secrets; print(secrets.token_hex(32))". Los ya guardados: scripts/cifrar_boveda.py
BOVEDA_LLAVE=

# La misma clave en core, rules y ai (32 caracteres o más).
JWT_SECRET=

# Cuentas de demostración del README, o un administrador inicial.
USUARIOS_DEMO=true
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_CONTRASENA=

RULES_BASE_URL=http://127.0.0.1:8002
RFC_DIGITO_ESTRICTO=false
REEVALUACION_INTERVALO_HORAS=24
ZONA_HORARIA=America/Mexico_City

# Correo (RF-20); vacío, apagado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
FRONTEND_URL=http://localhost:5173
