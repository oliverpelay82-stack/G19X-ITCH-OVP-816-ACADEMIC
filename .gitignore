# Entorno y secretos
.env
*.sql

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Bóveda física de documentos (binarios, no versionados)
storage_vault/*
!storage_vault/.gitkeep

# Editor / OS
.vscode/
.idea/
Thumbs.db

# Frontend (Vite + React)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Modelos de idioma de Tesseract: binarios de ~16 MB que se descargan en el
# despliegue (ver services/ai-service/README.md). El Dockerfile los
# instala desde los paquetes del sistema.
services/ai-service/tessdata/*.traineddata

# Texto extraído persistido por el ai-service (SQLite local, regenerable).
services/ai-service/data/

# Capturas de la regresión visual (scripts/regresion_visual.py): dependen de la BD local.
frontend/.regresion-visual/

# Salida de consola de OWASP ZAP (Q-c): se conservan los informes JSON y HTML.
docs/resultados_validacion/zap/*.log
