# Variables de Docker Compose (copia este archivo a .env y llena lo que uses).
# Sin .env, docker compose arranca con los valores de demostración del docker-compose.yml.
# Los valores reales están en «Accesos de prueba» (Mis documentos → Técnicos).

# Clave de Groq Cloud para la auditoría y el chat con IA (https://console.groq.com/keys).
# Sin ella, el sistema funciona completo salvo la IA, que responde con la instrucción para configurarla.
GROQ_API_KEY=

# Contraseña de la base PostgreSQL del contenedor (por omisión: plurione-demo).
DB_PASSWORD=

# Clave de firma de las sesiones, la misma para los tres servicios (32 caracteres o más).
# Por omisión el compose trae una de demostración, que /health del core advierte;
# con USUARIOS_DEMO=false el core no arranca con ella.
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=480

# Llave AES-256 de la bóveda (RNF-04): 64 caracteres hexadecimales. Por omisión el compose trae una
# de demostración, que /health del core advierte (con USUARIOS_DEMO=false, el core no arranca con ella). Guárdela también fuera del equipo: sin ella, los
# documentos cifrados no se recuperan. Generar: python -c "import secrets; print(secrets.token_hex(32))"
BOVEDA_LLAVE=

# true: crea las cuatro cuentas de demostración del README (admin@, validador@, auditor@ y consulta@example.com).
# En producción: false, con el administrador inicial (cambia su contraseña en el primer acceso).
USUARIOS_DEMO=true
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_CONTRASENA=

# true en producción: rechaza un RFC cuyo dígito verificador no coincide (en pruebas se acepta con advertencia).
RFC_DIGITO_ESTRICTO=false

# Avisos por correo a los validadores asignados (RF-20). Sin SMTP_HOST, el envío queda apagado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
SMTP_STARTTLS=true

FRONTEND_URL=http://localhost:5173
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
